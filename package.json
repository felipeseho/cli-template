{
  "name": "my-cli",
  "version": "0.1.0",
  "description": "A production-minded template for hybrid oclif and Ink terminal applications.",
  "author": "Your Name <you@example.com>",
  "private": true,
  "type": "module",
  "bin": {
    "mycli": "./bin/run.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "oclif.manifest.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run manifest",
    "clean": "node --eval \"import('node:fs').then(({rmSync}) => rmSync('dist', {recursive: true, force: true}))\"",
    "dev": "node --import tsx ./bin/dev.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "manifest": "oclif manifest",
    "postpack": "node --eval \"import('node:fs').then(({rmSync}) => rmSync('oclif.manifest.json', {force: true}))\"",
    "prepack": "npm run build && npm run manifest",
    "readme": "oclif readme --readme-path README.md",
    "smoke:package": "node ./scripts/smoke-package.mjs",
    "start": "node ./bin/run.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@oclif/core": "^4.14.0",
    "@oclif/plugin-help": "^6.3.0",
    "cli-spinners": "^3.4.0",
    "execa": "^10.0.1",
    "ink": "^7.1.1",
    "react": "^19.2.0",
    "string-width": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@oclif/test": "^4.2.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.2",
    "ink-testing-library": "^4.0.0",
    "oclif": "^4.24.0",
    "prettier": "^3.9.6",
    "rollup": "4.60.0",
    "tsc-alias": "^1.9.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.50.0",
    "vite": "6.4.3",
    "vitest": "^4.1.11"
  },
  "oclif": {
    "bin": "mycli",
    "dirname": "mycli",
    "default": "ui",
    "commands": {
      "strategy": "pattern",
      "target": "./dist/commands"
    },
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " ",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ],
    "repositoryPrefix": "https://github.com/your-org/my-cli/blob/main"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/my-cli.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/my-cli/issues"
  },
  "homepage": "https://github.com/your-org/my-cli#readme",
  "keywords": [
    "cli",
    "oclif",
    "ink",
    "termcn",
    "typescript"
  ],
  "license": "MIT"
}
